# Portkey Agent Skills Configuration

# Network: mainnet or testnet (default: mainnet)
PORTKEY_NETWORK=mainnet

# Override API base URL (optional, auto-detected from network)
# PORTKEY_API_URL=https://aa-portkey.portkey.finance

# Override EOA API base URL for asset fallback (optional)
# PORTKEY_EOA_API_URL=https://eoa-portkey.portkey.finance

# Override GraphQL URL (optional)
# PORTKEY_GRAPHQL_URL=https://indexer-api.aefinder.io/api/app/graphql/portkey

# Enable/disable AA -> EOA fallback in token-list auto mode (default: true)
# PORTKEY_EOA_FALLBACK_ENABLED=true

# EOA fallback retry attempts (including first attempt, default: 2)
# PORTKEY_EOA_FALLBACK_RETRY_COUNT=2

# EOA fallback retry delay in milliseconds (default: 200)
# PORTKEY_EOA_FALLBACK_RETRY_DELAY_MS=200

# Manager private key (required for write operations: transfer, guardian management)
# PORTKEY_PRIVATE_KEY=your_private_key_here
